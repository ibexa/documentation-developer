{% set basketProductCodes = [] %}
{% for entry in cart.entries %}
    {% set basketProductCodes = basketProductCodes|merge([entry.product.code]) %}
{% endfor %}

{% set basketContext = {
    'basketContent': basketProductCodes|join(','),  {# Comma-separated list: "PROD-001,PROD-002,PROD-003" #}
    'basketId': cart.id|default(cart.identifier)
} %}

{{ ibexa_tracking_track_event('basket', product, basketContext) }}
