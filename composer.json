{
    "name": "ibexa/documentation-developer",
    "description": "Cohesivo by Ibexa developer documentation as Markdown files, for offline reading and AI coding assistants working inside your project.",
    "type": "library",
    "keywords": ["ibexa", "cohesivo", "documentation", "markdown", "llm", "ai", "agents"],
    "license": "GNU General Public License v2.0",
    "autoload-dev": {
        "psr-4": {
            "Ibexa\\Tests\\Documentation\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://updates.ibexa.co"
        }
    ],
    "require": {
        "php": "^8.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "symfony/yaml": "^7.0",
        "ibexa/connector-gemini": "6.0.x-dev",
        "ibexa/doctrine-schema": "6.0.x-dev",
        "ibexa/search": "6.0.x-dev",
        "ibexa/content-forms": "6.0.x-dev",
        "ibexa/content-tree": "6.0.x-dev",
        "ibexa/design-engine": "6.0.x-dev",
        "ibexa/user": "6.0.x-dev",
        "ibexa/notifications": "6.0.x-dev",
        "ibexa/product-catalog-date-time-attribute": "6.0.x-dev",
        "ibexa/fieldtype-richtext": "6.0.x-dev",
        "ibexa/rest": "6.0.x-dev",
        "ibexa/http-cache": "6.0.x-dev",
        "ibexa/core-persistence": "6.0.x-dev",
        "ibexa/connector-ai": "6.0.x-dev",
        "ibexa/connector-openai": "6.0.x-dev",
        "ibexa/mcp": "6.0.x-dev",
        "ibexa/migrations": "6.0.x-dev",
        "ibexa/installer": "6.0.x-dev",
        "ibexa/product-catalog": "6.0.x-dev",
        "ibexa/graphql": "6.0.x-dev",
        "ibexa/personalization": "6.0.x-dev",
        "ibexa/taxonomy": "6.0.x-dev",
        "ibexa/scheduler": "6.0.x-dev",
        "ibexa/cron": "6.0.x-dev",
        "ibexa/dashboard": "6.0.x-dev",
        "ibexa/corporate-account": "6.0.x-dev",
        "ibexa/fieldtype-address": "6.0.x-dev",
        "ibexa/segmentation": "6.0.x-dev",
        "ibexa/fieldtype-page": "6.0.x-dev",
        "ibexa/page-builder": "6.0.x-dev",
        "ibexa/calendar": "6.0.x-dev",
        "ibexa/fieldtype-matrix": "6.0.x-dev",
        "ibexa/seo": "6.0.x-dev",
        "ibexa/core": "6.0.x-dev",
        "ibexa/admin-ui": "6.0.x-dev",
        "ibexa/activity-log": "6.0.x-dev",
        "ibexa/workflow": "6.0.x-dev",
        "ibexa/elasticsearch": "6.0.x-dev",
        "ibexa/oauth2-client": "6.0.x-dev",
        "ibexa/oauth2-server": "6.0.x-dev",
        "ibexa/form-builder": "6.0.x-dev",
        "ibexa/solr": "6.0.x-dev",
        "ibexa/version-comparison": "6.0.x-dev",
        "league/oauth2-google": "^4.0",
        "ibexa/connector-dam": "~6.0.x-dev",
        "ibexa/twig-components": "~6.0.x-dev",
        "ibexa/tree-builder": "~6.0.x-dev",
        "ibexa/core-search": "~6.0.x-dev",
        "ibexa/product-catalog-symbol-attribute": "~6.0.x-dev",
        "ibexa/messenger": "~6.0.x-dev",
        "ibexa/collaboration": "~6.0.x-dev",
        "ibexa/share": "~6.0.x-dev",
        "ibexa/connector-quable": "6.0.x-dev",
        "ibexa/cdp": "~6.0.x-dev",
        "ibexa/connector-raptor": "~6.0.x-dev",
        "ibexa/image-editor": "~6.0.x-dev",
        "ibexa/integrated-help": "~6.0.x-dev",
        "ibexa/translations-management": "~6.0.x-dev",
        "ibexa/site-context": "~6.0.x-dev",
        "ibexa/fieldtype-richtext-rte": "~6.0.x-dev",
        "ibexa/site-factory": "~6.0.x-dev",
        "ibexa/ckeditor-premium": "~6.0.x-dev",
        "ibexa/measurement": "~6.0.x-dev",
        "ibexa/fastly": "~6.0.x-dev",
        "ibexa/connect": "~6.0.x-dev",
        "ibexa/connector-qualifio": "~6.0.x-dev",
        "ibexa/design-system-twig": "~6.0.x-dev"
    },
    "scripts": {
        "check-yaml": "phpunit --group yaml",
        "phpunit": "phpunit --exclude-group=yaml",
        "yaml-update-baseline": "php tests/generate-yaml-baseline.php",
        "composer-update": "[ -d vendor ] || composer update",
        "yarn-install": "[ -d node_modules ] || yarn install",
        "markdownlint": [
            "@yarn-install",
            "yarn markdownlint"
        ],
        "fix-markdownlint": [
            "@yarn-install",
            "yarn markdownlint --fix"
        ],
        "test": [
            "@composer-update",
            "EXIT=0; FAILED=''; { composer markdownlint; } || { EXIT=1; FAILED=\"$FAILED markdownlint\"; }; { composer check-yaml; } || { EXIT=1;  FAILED=\"$FAILED check-yaml\"; }; if [ 1 -eq $EXIT ]; then echo \"Failed:$FAILED\"; fi; exit $EXIT;"
        ],
        "fix": [
            "@composer fix-markdownlint"
        ],
        "baseline": [
            "@composer-update",
            "@composer yaml-update-baseline"
        ]
    },
    "scripts-descriptions": {
        "check-yaml": "Run PHPUnit tests (YAML validation)",
        "yaml-update-baseline": "Regenerate tests/yaml-validation-baseline.yaml from current failures",
        "composer-update": "Install composer dependencies if not already installed",
        "yarn-install": "Install yarn dependencies if not already installed",
        "markdownlint": "Run Markdownlint on all documentation files",
        "fix-markdownlint": "Automatically fixes Markdownlint issues in all documentation files",
        "test": "Run all checks (Markdownlint, YAML checks), continuing past failures and reporting failure overall if any check failed",
        "fix": "Run all automatic fixes (Markdownlint)",
        "baseline": "Regenerate the YAML validation baseline from current failures"
    },
    "config": {
        "allow-plugins": false
    }
}
